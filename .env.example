# --- Required ---
# MongoDB connection (local install, Docker, or MongoDB Atlas)
DATABASE_URI=mongodb://127.0.0.1:27017/aqua-aman
# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
# Public URL of this app. Used to build Driver App links and PDF/QR links.
URL=http://localhost:3000

# --- Optional: file storage for the company logo / media (uploadthing.com) ---
UPLOADTHING_TOKEN=

# --- Optional: email delivery receipts (any SMTP provider) ---
FROM_NAME=Aqua Aman
FROM_EMAIL=noreply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Optional: WhatsApp bridge (separate service exposing /clients/:id/send-message) ---
NEXT_PUBLIC_WHATSAPP_API_URL=
